OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional OpenRouter Management API key for reading account credits in the admin dashboard.
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_FALLBACK_MODEL=openai/gpt-6-luna
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# RAFA Supabase backend.
RAFA_API_SECRET=generate-a-random-32-byte-secret
RAFA_DASHBOARD_SUPABASE_SECRET=generate-a-different-random-32-byte-secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
RAFA_API_URL=https://your-project-ref.supabase.co/functions/v1/rafa-agent-api

# Email for monthly reports and booking notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
REPORT_EMAIL_TO=your-email@example.com
ALERT_EMAIL_TO=your-email@example.com
REPORT_EMAIL_FROM=your-gmail-address@gmail.com
REPORT_CRON=0 9 1 * *
REPORT_TIMEZONE=Europe/Nicosia

# Google Calendar booking.
# Optional for OAuth; RAFA uses the authenticated owner's primary calendar. Required for a service account.
# For the owner's primary calendar, use an OAuth client authorized with offline access and these narrow scopes.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Alternatively, use a service account and share the target calendar with it.
GOOGLE_CALENDAR_CLIENT_EMAIL=service-account-name@project-id.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Non-secret booking rules are managed in the dashboard and stored in Supabase.
BOOKING_NOTIFY_EMAIL=your-email@example.com
DASHBOARD_PUBLIC_URL=https://your-dashboard.example.com
OWNER_WHATSAPP_JID=

# Pairing-only connects WhatsApp for QR setup without handling messages or running outbound schedules.
RAFA_PAIRING_ONLY=false

# Spam and OpenRouter cost controls.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# Automatic customer follow-up.
FOLLOW_UP_ENABLED=true
FOLLOW_UP_DELAY_HOURS=24
FOLLOW_UP_CRON=0 * * * *
FOLLOW_UP_TIMEZONE=Europe/Nicosia

# Connection health alerts.
DISCONNECT_ALERT_DELAY_MS=120000

# Dashboard.
DASHBOARD_PORT=8787
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_AUTH_SITE_URL=http://localhost:8787
RAFA_INITIAL_ADMIN_EMAIL=admin@example.com
OPENROUTER_ESTIMATED_TOKENS_PER_REQUEST=1000
OPENROUTER_ESTIMATED_COST_PER_1K=0

